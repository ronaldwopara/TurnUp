DATABASE_URL="file:./dev.db"

# Clerk authentication (https://dashboard.clerk.com → API Keys)
# Required for stable auth. Without these, Clerk runs in ephemeral "keyless" dev mode
# and session token refresh often fails with "Failed to fetch" network errors.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Multimodal extraction provider (OpenAI-compatible endpoint).
TURNUP_LLM_API_KEY=""
TURNUP_LLM_MODEL="gpt-4.1"
TURNUP_LLM_API_URL="https://api.openai.com/v1/chat/completions"

# Optional social download adapter key/URL (Cobalt-compatible).
COBALT_API_URL="https://api.cobalt.tools/"
COBALT_API_KEY=""

# Optional Microlink API key (free tier works without key at low volume).
MICROLINK_API_KEY=""

# Peekalink link previews (https://docs.peekalink.io/quickstart) — poster + metadata.
PEEKALINK_API_KEY=""

# ── Mobile app (copy to mobile/.env) ─────────────────────────────────────────
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""  # same value as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# EXPO_PUBLIC_API_URL="http://localhost:3000"
